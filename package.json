{
  "name": "rakazo",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo dev --filter=@rakazo/api --filter=@rakazo/worker --filter=@rakazo/web --filter=@rakazo/sandbox-supervisor",
    "build": "turbo build",
    "check": "turbo check",
    "lint": "biome check .",
    "format": "biome check --write .",
    "db:generate": "pnpm --filter @rakazo/db generate",
    "db:migrate": "pnpm --filter @rakazo/db migrate",
    "sandbox:build": "docker build -t rakazo/computer:local infra/sandboxes/computer",
    "test": "vitest run",
    "test:integration": "tsx packages/testkit/src/cli/harness.ts --integration",
    "test:e2e": "tsx packages/testkit/src/cli/harness.ts --e2e",
    "test:topology": "tsx packages/testkit/src/cli/topology.ts",
    "test:canary": "tsx packages/testkit/src/cli/canary.ts",
    "test:computer": "tsx packages/testkit/src/cli/computer.ts",
    "perf:desktop": "tsx packages/testkit/src/cli/desktop-performance.ts",
    "perf:compare": "tsx packages/testkit/src/cli/compare-performance.ts",
    "compose:up": "docker compose --env-file .env -f infra/compose/docker-compose.yml up --build",
    "compose:down": "docker compose --env-file .env -f infra/compose/docker-compose.yml down -v"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "overrides": {
      "react": "19.2.3",
      "react-dom": "19.2.3",
      "@grpc/grpc-js@<1.14.5": "1.14.7",
      "@xmldom/xmldom@>=0.8 <0.8.15": "0.8.15",
      "@xmldom/xmldom@>=0.9 <0.9.12": "0.9.12",
      "axios@>=1 <1.20.0": "1.20.0",
      "body-parser@>=2 <2.4.0": "2.4.0",
      "brace-expansion@>=1 <1.1.20": "1.1.21",
      "brace-expansion@>=2 <2.1.6": "2.1.7",
      "brace-expansion@>=4 <5.0.11": "5.0.12",
      "compression@<1.8.2": "1.8.2",
      "decode-uri-component@<0.5.1": "0.5.1",
      "devalue@>=5 <5.9.3": "5.9.3",
      "dompurify@<3.4.17": "3.4.17",
      "e2b>undici8": "npm:undici@8.12.4",
      "fast-uri@>=3 <3.1.7": "3.1.9",
      "follow-redirects@<1.16.2": "1.16.2",
      "js-yaml@>=4 <4.3.2": "4.3.2",
      "markdown-it@>=14 <14.3.3": "14.3.3",
      "mysql2@<3.22.0": "3.24.4",
      "node-forge@<1.4.3": "1.4.3",
      "proxy-addr@<2.0.8": "2.0.8",
      "sharp@<0.35.5": "0.35.5",
      "shell-quote@>=1 <1.11.0": "1.12.0",
      "source-map-js@>=1 <1.2.2": "1.2.2",
      "svgo@>=4 <4.1.0": "4.1.0",
      "undici@>=6 <6.29.1": "6.29.1",
      "undici@>=7 <7.30.1": "7.30.2",
      "undici@>=8 <8.12.2": "8.12.4",
      "zod@>=4 <4.6.6": "4.6.7",
      "metro@>=0.84 <0.84.5": "0.84.5",
      "metro-config@>=0.84 <0.84.5": "0.84.5"
    },
    "patchedDependencies": {
      "query-string@7.1.3": "patches/query-string@7.1.3.patch"
    }
  }
}
